import { useRef, useState } from "react";

interface Props {
  src: string;
  description: string;
}

export default function VideoPlayer({
  src,
  description
}: Props) {
  const videoRef = useRef<HTMLVideoElement>(null);
  const [muted, setMuted] = useState(true);

  function toggleMute() {
    const next = !muted;
    setMuted(next);

    if (videoRef.current) {
      videoRef.current.muted = next;
    }
  }

  return (
    <div
      style={{
        height: "100dvh",
        width: "100%",
        position: "relative",
        background: "black",
        overflow: "hidden"
      }}
    >
      <video
        ref={videoRef}
        src={src}
        autoPlay
        loop
        muted={muted}
        playsInline
        controls={false}
        style={{
          width: "100%",
          height: "100%",
          objectFit: "contain"
        }}
      />

      <p
        style={{
          position: "absolute",
          bottom: 70,
          left: 16,
          color: "white"
        }}
      >
        {description}
      </p>

      <button
        onClick={toggleMute}
        style={{
          position: "absolute",
          right: 16,
          bottom: 30
        }}
      >
        {muted ? "Włącz dźwięk" : "Wycisz"}
      </button>
    </div>
  );
}
